      "translations": {
        "en": {
          "name": "Omelet Wraps",
          "category_label": "Breakfast",
          "serving_unit_label": "serving",
          "instructions": [
            "Place the cottage cheese, watercress and lemon peel in a high bowl and puree with the hand blender (or food processor) until smooth paste forms.",
            "Beat the eggs with the milk and herbs in a separate bowl.",
            "Heat 1 tsp. of oil in the medium size frying pan and fry 1/4 of the egg over medium heat for 2 minutes until the egg solidifies, then turn around. Bake the other side for 0.5 minute.",
            "Remove the omelet from the pan and set aside. Fry the other omelets with the rest of the oil.",
            "To serve, spread the cottage cheese paste over the omelets and top with smoked salmon. Roll up the omelet as a wrap and cut in half."
          ],
          "notes": null
        },
        "sk": {
          "name": "Omeletové wrapy",
          "category_label": "Raňajky",
          "serving_unit_label": "porcia",
          "instructions": [
            "Cottage syr, potočnicu a citrónovú kôru dajte do vysokej misky a pomocou tyčového mixéra (alebo kuchynského robota) rozmixujte na hladkú pastu.",
            "V inej miske vyšľahajte vajcia s mliekom a bylinkami.",
            "V stredne veľkej panvici zohrejte 1 čl oleja a pražte 1/4 vaječnej zmesi na strednom ohni približne 2 minúty, kým vajíčko nestuhne, potom ho otočte. Opekajte z druhej strany pol minúty.",
            "Omeletu vyberte z panvice a dajte bokom. Rovnako pripravte ďalšie omelety zo zvyšného oleja a zmesi.",
            "Na podávanie natrite pastu z cottage syra na omelety a navrch dajte údeného lososa. Omeletu zrolujte ako wrap a prerežte na polovicu."
          ],
          "notes": null
        }
      },
      "meal_prep_friendly": false
