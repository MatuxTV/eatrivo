      "translations": {
        "en": {
          "name": "Quick Protein Fruit Cake",
          "category_label": "Breakfast",
          "serving_unit_label": "cake",
          "instructions": [
            "In a suitable bowl, thoroughly mix the egg, Greek yogurt, spelt flour, kefir, vanilla protein, baking powder, and honey. Mix well to create a smooth, lump-free batter.",
            "Pour the batter into a small baking dish (for one serving) and generously top with your favorite fruit.",
            "Place the cake in a preheated oven at 350°F (180°C) and bake for approximately 30 minutes."
          ],
          "notes": "You can easily double the ingredients to make a double batch."
        },
        "sk": {
          "name": "Rýchly proteínový koláč s ovocím",
          "category_label": "Raňajky",
          "serving_unit_label": "koláčik",
          "instructions": [
            "Vo vhodnej miske dôkladne zmiešajte vajce, grécky jogurt, špaldovú múku, kefír, vanilkový proteín, kypriaci prášok a med. Poriadne premiešajte, aby vám vzniklo hladké cesto bez hrudiek.",
            "Cesto prelejte do menšej zapekacej misky a navrch bohato poukladajte obľúbené ovocie.",
            "Koláč vložte do rúry vyhriatej na 180°C a pečte približne 30 minút."
          ],
          "notes": "Môžete si rovno pripraviť dvojitú dávku jednoduchým vynásobením množstiev dvomi."
        }
