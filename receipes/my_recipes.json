      "translations": {
        "en": {
          "name": "Strawberry Protein Pancakes",
          "category_label": "Breakfast",
          "serving_unit_label": "serving",
          "instructions": [
            "Place the cottage cheese and eggs in a blender and blend until smooth. Add in the protein powder and blend again.",
            "Heat a tsp of oil in a pan on medium-low heat. Pour 2 tbsp. of the batter into the pan. Cook until bubbles start to appear on the surface, then flip and cook for another minute until golden. Repeat until you use all the batter.",
            "Serve with chopped strawberries."
          ],
          "notes": "You can substitute the whey protein for another flavor if you prefer."
        },
        "sk": {
          "name": "Jahodové proteínové lievance",
          "category_label": "Raňajky",
          "serving_unit_label": "porcia",
          "instructions": [
            "Cottage syr a vajcia dajte do mixéra a rozmixujte dohladka. Pridajte proteínový prášok a znova rozmixujte.",
            "Na panvici zohrejte 1 lyžičku oleja na stredne nízkej teplote. Nalejte do panvice časť cesta (asi 2 polievkové lyžice na lievanec). Opekajte, kým sa na povrchu nezačnú tvoriť bublinky, potom otočte a opekajte ďalšiu minútu dozlatista. Opakujte, kým neminiete všetko cesto.",
            "Podávajte s nakrájanými jahodami."
          ],
          "notes": "Ak uprednostňujete inú príchuť, môžete vanilkový srvátkový proteín nahradiť za iný."
        }
      },
