      "translations": {
        "en": {
          "name": "Oatmeal Fitness Pancakes",
          "category_label": "Breakfast",
          "serving_unit_label": "serving",
          "instructions": [
            "Add milk, eggs, ripe bananas, rolled oats, and protein powder into a blender. Blend thoroughly until you have a smooth pancake batter.",
            "Heat the olive oil in a pan over medium heat. Pour in small amounts of batter to form pancakes.",
            "Cook until the edges set and bubbles form on the surface, then flip and cook until golden brown on the other side.",
            "Serve the pancakes topped with fresh strawberries, a dollop of yogurt, and a drizzle of pistachio butter."
          ],
          "notes": null
        },
        "sk": {
          "name": "Ovsené fitness lievance",
          "category_label": "Raňajky",
          "serving_unit_label": "porcia",
          "instructions": [
            "Do mixéra pridajte mlieko, vajcia, zrelé banány, ovsené vločky a proteínový prášok. Poriadne rozmixujte, kým nevznikne hladké cesto na lievance.",
            "Na panvici zohrejte olivový olej. Nalejte menšie porcie cesta a vytvarujte lievance.",
            "Opekajte, kým sa na povrchu nezačnú tvoriť bublinky a okraje nestuhnú. Potom lievance pretočte a opečte dozlatista aj z druhej strany.",
            "Hotové lievance podávajte ozdobené čerstvými jahodami, jogurtom a pistáciovým maslom."
          ],
          "notes": null
        }
      },
