      "translations": {
        "en": {
          "name": "Juicy One-Pan Teriyaki Chicken",
          "category_label": "Lunch",
          "serving_unit_label": "serving",
          "instructions": [
            "Cook the rice according to the package instructions and set aside.",
            "Cut the chicken breasts into bite-sized pieces. In a small bowl, whisk together the soy sauce, honey, minced garlic, grated ginger, and corn starch.",
            "Heat the oil in a large frying pan over medium-high heat. Add the chicken pieces and sear until golden brown and cooked through.",
            "Pour the teriyaki sauce mixture into the pan with the chicken. Stir constantly as the sauce bubbles and thickens into a glossy glaze, coating all the meat.",
            "Serve the chicken hot over the prepared rice."
          ],
          "notes": null
        },
        "sk": {
          "name": "Šťavnaté kuracie prsia s teriyaki omáčkou z panvice",
          "category_label": "Obed",
          "serving_unit_label": "porcia",
          "instructions": [
            "Ryžu uvarte podľa návodu na obale a odložte bokom.",
            "Kuracie prsia nakrájajte na kúsky veľkosti sústa. V malej miske vymiešajte sójovú omáčku, med, prelisovaný cesnak, nastrúhaný zázvor a kukuričný škrob.",
            "Na veľkej panvici zohrejte olej na stredne silnom ohni. Pridajte kúsky kuraťa a opekajte dozlatista, kým nie je mäso hotové.",
            "Kura zalejte pripravenou teriyaki zmesou. Za stáleho miešania nechajte omáčku prebublať, kým nezhustne a rovnomerne neobalí všetky kúsky mäsa.",
            "Podávajte horúce s pripravenou ryžou."
          ],
          "notes": null
        }
      },
      "meal_prep_friendly": true
    },
