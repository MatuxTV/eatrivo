```mermaid
%% Canonical catalog schema
erDiagram
    users ||--o{ ingredients : "owner_user_id (nullable = global)"
    ingredients ||--o{ ingredients : "parent_id (family → specific)"
    ingredients ||--o{ ingredient_names : "locale display names"
    ingredients ||--o{ ingredient_aliases : "lookup aliases"
    ingredients ||--o{ pantry_items : "ingredient_id"
    ingredients ||--o{ shopping_list_items : "ingredient_id"
    ingredients ||--o{ pantry_restock_items : "ingredient_id"
    ingredients ||--o{ recipe_ingredients : "ingredient_id"

    ingredients {
        uuid id PK
        text key "UNIQUE NULLS NOT DISTINCT (owner_user_id, key)"
        uuid parent_id FK
        text canonical_name
        uuid owner_user_id "NULL = global, set = private"
        enum review_state "trusted | unverified | flagged"
        enum source "recipe | admin | user | ai"
    }
    ingredient_names {
        uuid ingredient_id FK
        text locale
        text name
    }
    ingredient_aliases {
        uuid id PK
        uuid ingredient_id FK
        text locale "nullable"
        text alias
        uuid owner_user_id "scoped uniqueness"
    }
