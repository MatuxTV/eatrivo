{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 0,
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Default builder for the eatrivo Next.js PWA. Full tool access."
    },
    "plan": {
      "mode": "primary",
      "description": "Read-only planning/architecture for eatrivo. No edits or shell side effects.",
      "tools": {
        "write": false,
        "edit": false,
        "patch": false
      }
    },
    "coder": {
      "mode": "primary",
      "description": "Implementuje kód podľa .agent/spec.md",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
      "temperature": 0.2,
      "steps": 20,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    },
    "tester": {
      "mode": "primary",
      "description": "Píše a spúšťa testy, hlási zlyhania",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
      "temperature": 0.1,
      "steps": 20,
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow"
      }
    }
  },
  "permission": {
    "external_directory": "ask"
  }
}
